"LightmappedGeneric"
{
	"$abovewater" 1
	"$basetexture" "barney/SCROLL_WTR_GRN"
	"$translucent" "0"
	//"$alpha" "1.00"
	
	"%compilewater" 1
	"$surfaceprop" "water"
	"$bottommaterial" "barney/SCROLL_WTR_GRN_beneath"
	
	"$angle" 0
	"$translate" 0
	"$scale" "[.5 .5]"
	
	"Proxies"
	{
		"Sine"
		{
			"sineperiod" 7
			"sinemin" "1.0"
			"sinemax" "1.001"
			"resultVar" "$scale"
		}
		
		"Sine"
		{
			"sineperiod" 8
			"sinemin" "-.05"
			"sinemax" ".05"
			"resultVar" "$translate"
		}
		
		"Sine"
		{
			"sineperiod" 17
			"sinemin" ".15"
			"sinemax" ".05"
			"resultVar" "$angle"
		}

		"ConveyorScroll"
		{
			"textureScrollVar" "$translate"
		}

		"TextureTransform"
		{
			"translateVar" "$translate"
			"rotateVar" "$angle"
			"scaleVar" "$scale"
			"resultVar" "$basetexturetransform"
		}
	}
}