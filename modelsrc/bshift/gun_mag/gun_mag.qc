$modelname "gun_mag.mdl"

$bodygroup "studio"
{
	studio "gun_mag"
}

$SurfaceProp "carpet"

$Contents "solid"

$cdmaterials "models\gun_mag\"

$cbox 0 0 0 0 0 0

$bbox -8 -10 0 8 10 2

$definebone "Bone01" "" -0.006356 0.026631 0.052714 0.000000 0.000000 -53.499991 0.000000 0.000000 0.000000 -0.000000 0.000000 0.000000
