$definebone "Bone03" "Bone02" 0.000422 1.815479 0.272587 -0.000000 0.000000 0.000000 0.000000 0.000000 0.000000 -0.000000 0.000000 0.000000
$definebone "Bone04" "Bone03" 0.000000 1.484460 -0.143585 -0.000000 0.000000 0.000000 0.000000 0.000000 0.000000 -0.000000 0.000000 0.000000
$definebone "Bone05" "Bone04" -0.007063 2.809087 -0.364261 -0.000000 0.000000 0.000000 0.000000 0.000000 0.000000 -0.000000 0.000000 0.000000
$definebone "Bone06" "Bone05" 0.019010 2.546382 -0.350745 -0.000000 0.000000 0.000000 0.000000 0.000000 0.000000 -0.000000 0.000000 0.000000
$definebone "magazine_base" "" -0.274832 0.083089 -0.119681 0.000000 0.000000 0.000000 0.000000 0.000000 0.000000 -0.000000 0.000000 0.000000

$sequence "idle1" {
	"gun_mag_anims\idle1"
	activity "ACT_IDLE" 1
	snap
	fps 30
}

$sequence "flip" {
	"gun_mag_anims\flip"
	snap
	fps 25
}